<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_cream"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme_mode"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_system"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_system"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_light"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_light"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_dark"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/theme_dark"
            android:textColor="@color/text_primary"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_preview"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@color/theme_preview_light_bg"
                android:layout_marginEnd="8dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/light_preview"
                    android:textSize="12sp"
                    android:textColor="@color/theme_preview_light_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@color/theme_preview_dark_bg"
                android:layout_marginStart="8dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dark_preview"
                    android:textSize="12sp"
                    android:textColor="@color/theme_preview_dark_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
